/* Shared rofi layout for every theme. Each theme-*.rasi only defines the
   palette variables below, then @imports this file.

   Variables each theme sets:
     bg, bg-alt, fg, dim, accent, accent-fg, border */

configuration {
    show-icons:          true;
    display-drun:        "󰀻  apps";
    display-window:      "󰖯  windows";
    display-run:         "󰆍  run";
    drun-display-format: "{name}";
    window-format:       "{w}   {c}   {t}";
    hover-select:        true;
    me-select-entry:     "";
    me-accept-entry:     "MousePrimary";
}

* {
    background-color: transparent;
    text-color:       @fg;
    font:             "Cascadia Mono NF 11";
}

window {
    transparency:     "real";
    width:            40%;
    background-color: @bg;
    border:           1px;
    border-color:     @border;
    border-radius:    14px;
    padding:          0;
}

mainbox {
    children: [ inputbar, message, listview ];
    spacing:  0;
    padding:  0;
}

/* Header strip holding a rounded search pill. */
inputbar {
    background-color: @bg-alt;
    padding:          16px 18px;
    border:           0 0 1px 0;
    border-color:     @border;
    children:         [ searchpill ];
}

searchpill {
    orientation:      horizontal;
    background-color: @bg;
    border:           1px;
    border-color:     @border;
    border-radius:    100%;
    padding:          10px 18px;
    spacing:          12px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @accent;
}

entry {
    text-color:        @fg;
    cursor:            text;
    placeholder:       "type to search";
    placeholder-color: @dim;
}

message {
    background-color: @bg-alt;
    margin:           14px 18px 0 18px;
    padding:          8px 12px;
    border:           0 0 0 3px;
    border-color:     @accent;
    border-radius:    8px;
}

textbox {
    text-color: @fg;
}

listview {
    lines:        7;
    columns:      1;
    spacing:      4px;
    padding:      14px 14px 14px 14px;
    cycle:        true;
    dynamic:      true;
    scrollbar:    true;
    fixed-height: false;
}

scrollbar {
    background-color: @bg-alt;
    handle-color:     @accent;
    handle-width:     3px;
    border-radius:    3px;
    margin:           0 0 0 6px;
}

element {
    padding:       9px 12px;
    border-radius: 10px;
    orientation:   horizontal;
    spacing:       12px;
    children:      [ element-icon, element-text ];
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}

element normal.urgent, element alternate.urgent {
    text-color: @accent;
}

element normal.active, element alternate.active {
    text-color: @accent;
}

element selected.normal, element selected.urgent, element selected.active {
    background-color: @accent;
    text-color:       @accent-fg;
}

element-icon {
    size:           1.4em;
    vertical-align: 0.5;
}

element-text {
    text-color:     inherit;
    vertical-align: 0.5;
}

/* Tabs along the bottom — not in mainbox by default; the $mod+d launcher
   adds it with -theme-str so apps / windows / run can be flipped through. */
mode-switcher {
    background-color: @bg-alt;
    padding:          8px;
    spacing:          8px;
    border:           1px 0 0 0;
    border-color:     @border;
}

button {
    padding:       7px;
    border-radius: 8px;
    text-color:    @dim;
}

button selected {
    background-color: @accent;
    text-color:       @accent-fg;
}

error-message {
    background-color: @bg;
    padding:          14px;
    border:           1px;
    border-color:     @accent;
    border-radius:    14px;
}

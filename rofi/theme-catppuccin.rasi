/* Catppuccin Mocha rofi theme — palette only; layout lives in layout.rasi */

* {
    bg:        #1e1e2e;
    bg-alt:    #181825;
    fg:        #cdd6f4;
    dim:       #7f849c;
    accent:    #cba6f7;
    accent-fg: #11111b;
    border:    #45475a;
}

configuration {
    icon-theme: "breeze-dark";
}

@import "layout.rasi"

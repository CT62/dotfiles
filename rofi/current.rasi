/* Black & white rofi theme — palette only; layout lives in layout.rasi */

* {
    bg:        #000000;
    bg-alt:    #111111;
    fg:        #FFFFFF;
    dim:       #6E6E6E;
    accent:    #FFFFFF;
    accent-fg: #000000;
    border:    #2E2E2E;
}

configuration {
    icon-theme: "breeze-dark";
}

@import "layout.rasi"

/* Inverted (snowy field) rofi theme, softened for readability */

* {
    bg:      #E9E9E6;
    bg-alt:  #DFDFDA;
    fg:      #161616;
    dim:     #5E5E58;
    sel-bg:  #161616;
    sel-fg:  #E9E9E6;

    background-color: @bg;
    text-color:        @fg;
    font: "Cascadia Mono NF 11";
}

window {
    width: 34%;
    background-color: @bg;
    border: 1px;
    border-color: @dim;
    border-radius: 6px;
    padding: 16px;
}

mainbox {
    background-color: @bg;
    children: [ inputbar, message, listview ];
    spacing: 14px;
}

inputbar {
    background-color: @bg-alt;
    text-color: @fg;
    border: 1px;
    border-color: #CFCFC9;
    border-radius: 8px;
    padding: 9px 12px;
    children: [ prompt, entry ];
}

prompt {
    background-color: inherit;
    text-color: @dim;
    padding: 0 8px 0 0;
}

entry {
    background-color: inherit;
    text-color: @fg;
    placeholder: "search";
    placeholder-color: @dim;
}

listview {
    background-color: @bg;
    lines: 8;
    spacing: 4px;
    cycle: true;
    dynamic: true;
    scrollbar: true;
}

scrollbar {
    background-color: @bg-alt;
    handle-color: @dim;
    handle-width: 4px;
    border-radius: 4px;
}

element {
    background-color: @bg;
    text-color: @fg;
    padding: 7px 10px;
    border-radius: 6px;
    orientation: horizontal;
    children: [ element-icon, element-text ];
    spacing: 10px;
}

element-icon {
    size: 1.15em;
    vertical-align: 0.5;
    background-color: inherit;
}

element selected {
    background-color: @sel-bg;
    text-color: @sel-fg;
}

element-text {
    background-color: inherit;
    text-color: inherit;
    vertical-align: 0.5;
}

message {
    background-color: @bg-alt;
    border-radius: 8px;
    padding: 8px 10px;
    margin: 0 0 4px 0;
}

textbox {
    text-color: @fg;
}

error-message {
    background-color: @bg-alt;
    text-color: @fg;
    border: 1px;
    border-color: @dim;
    border-radius: 8px;
    padding: 10px;
}

/* Inverted (snowy field) rofi theme — palette only; layout lives in
   layout.rasi */

* {
    bg:        #E9E9E6;
    bg-alt:    #DCDCD7;
    fg:        #161616;
    dim:       #6E6E68;
    accent:    #161616;
    accent-fg: #E9E9E6;
    border:    #C4C4BE;
}

configuration {
    icon-theme: "breeze";
}

@import "layout.rasi"

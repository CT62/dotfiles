# i3 config — part of the dotfiles rice (see ~/dotfiles/README.md).
# Reference: https://i3wm.org/docs/userguide.html

set $mod Mod4

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:Cascadia Mono NF 9

# Monitor layout: DVI-D-1 landscape/primary (1), HDMI-1 portrait (2)
exec_always --no-startup-id ~/.config/rice/set-monitors.sh

# Set wallpaper according to whichever theme (bw/invert) was last selected
exec --no-startup-id ~/.config/rice/set-wallpaper.sh

# Compositor for fades/transparency (restart cleanly on reload). One
# picom.conf is shared by every theme.
exec_always --no-startup-id "pkill picom; picom --config ~/.config/picom/picom.conf -b"

# Polybar replaces the built-in i3bar: full bar on the primary monitor,
# slim workspace/clock bar on the others (see polybar/launch.sh)
exec_always --no-startup-id ~/.config/polybar/launch.sh

# Start XDG autostart .desktop files using dex. See also
# https://wiki.archlinux.org/index.php/XDG_Autostart
exec --no-startup-id dex-autostart --autostart --environment i3

# xss-lock grabs a logind suspend inhibit lock and will use i3lock to lock the
# screen before suspend. Use loginctl lock-session to lock your screen.
exec --no-startup-id xss-lock --transfer-sleep-lock -- ~/.config/rice/lock.sh

# 5 minutes idle triggers the X screensaver, which xss-lock (above) is
# already listening for and turns into an automatic lock.
exec_always --no-startup-id xset s 300 300

# No wifi hardware on this box (ethernet only) and the bar's network module
# already shows connection status, so nm-applet's tray icon isn't needed.

# Warmer color temperature in the evening — no longer auto-started here.
# A systemd --user timer (gammastep-prompt.timer) prompts at dusk instead
# of just switching it on; see ~/.config/rice/gammastep-prompt.sh and
# ~/.config/gammastep/config.ini for the dusk-time window.

# Headless clipboard history server for the $mod+Shift+v rofi picker
exec --no-startup-id copyq --start-server

# Use pactl to adjust volume in PulseAudio (polybar's pulseaudio module
# updates itself on these events, no manual refresh needed).
bindsym XF86AudioRaiseVolume exec --no-startup-id "pactl set-sink-volume @DEFAULT_SINK@ +10% && ~/.config/rice/osd.sh volume"
bindsym XF86AudioLowerVolume exec --no-startup-id "pactl set-sink-volume @DEFAULT_SINK@ -10% && ~/.config/rice/osd.sh volume"
bindsym XF86AudioMute exec --no-startup-id "pactl set-sink-mute @DEFAULT_SINK@ toggle && ~/.config/rice/osd.sh volume"
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Brightness
bindsym XF86MonBrightnessUp exec --no-startup-id "brightnessctl set +10% && ~/.config/rice/osd.sh brightness"
bindsym XF86MonBrightnessDown exec --no-startup-id "brightnessctl set 10%- && ~/.config/rice/osd.sh brightness"

# Select an area and copy the screenshot straight to the clipboard (no file saved)
bindsym $mod+Shift+s exec --no-startup-id "maim -s | xclip -selection clipboard -t image/png"

# Same, but with flameshot's annotate/arrow/blur editor before copying
bindsym Print exec --no-startup-id flameshot gui

# Lock the screen (routes through xss-lock -> lock.sh, themed blurred lock)
bindsym $mod+Shift+x exec --no-startup-id loginctl lock-session

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# No title bars — thin borders only
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

# A medium gap between windows (screen edges get outer + inner = 12px)
gaps inner 8
gaps outer 4

# start a terminal
bindsym $mod+Return exec kitty

# kill focused window
bindsym $mod+q kill

# start rofi launcher (themed; tabs along the bottom flip between apps /
# windows / run — click them or use Shift+Left/Right)
bindsym $mod+d exec --no-startup-id "rofi -show drun -modi drun,window,run -theme ~/.config/rofi/current.rasi -theme-str 'mainbox { children: [ inputbar, message, listview, mode-switcher ]; }'"

# rofi calculator, emoji picker and clipboard history (custom script-modi)
bindsym $mod+comma exec --no-startup-id "rofi -show calc -modi calc:~/.config/rofi/calc.sh -theme ~/.config/rofi/current.rasi"
bindsym $mod+period exec --no-startup-id "rofi -show emoji -modi emoji:~/.config/rofi/emoji.sh -theme ~/.config/rofi/current.rasi"
bindsym $mod+Shift+v exec --no-startup-id "rofi -show clipboard -modi clipboard:~/.config/rofi/clipboard.sh -theme ~/.config/rofi/current.rasi"

# rofi power menu (lock/suspend/reboot/shutdown) — also on the polybar button
bindsym $mod+Shift+p exec --no-startup-id ~/.config/polybar/powermenu.sh

# rofi bluetooth device picker — also on the polybar bluetooth module (left-click)
bindsym $mod+Shift+b exec --no-startup-id "rofi -show bluetooth -modi bluetooth:~/.config/rofi/bluetooth.sh -theme ~/.config/rofi/current.rasi"

# cycle the rice theme: bw -> invert -> catppuccin
bindsym $mod+Shift+t exec --no-startup-id ~/.config/rice/toggle-theme.sh

# pick a theme from a rofi menu (with palette swatches) instead of cycling
bindsym $mod+t exec --no-startup-id ~/.config/rice/theme-picker.sh

# shuffle to another wallpaper from the current theme's set
bindsym $mod+Shift+w exec --no-startup-id ~/.config/rice/set-wallpaper.sh

# rofi window switcher across every workspace
bindsym $mod+Tab exec --no-startup-id "rofi -show window -theme ~/.config/rofi/current.rasi"

# searchable cheatsheet of every keybinding (Enter runs the selected one)
bindsym $mod+slash exec --no-startup-id ~/.config/rice/keybinds.sh

# focused window opacity: more see-through / more solid / reset
bindsym $mod+bracketleft exec --no-startup-id picom-trans -c -5
bindsym $mod+bracketright exec --no-startup-id picom-trans -c +5
bindsym $mod+backslash exec --no-startup-id picom-trans -c -d

# save / restore the focused workspace's layout (i3-save-tree based)
bindsym $mod+Shift+u exec --no-startup-id ~/.config/rice/save-layout.sh
bindsym $mod+y exec --no-startup-id ~/.config/rice/restore-layout.sh

# Scratchpad dropdown terminal: $mod+grave summons/hides a kitty marked
# "scratch_term", spawning it on first use (see scratch-toggle.sh).
for_window [instance="scratch_term"] move scratchpad, resize set 1200 700, move position center
bindsym $mod+grave exec --no-startup-id ~/.config/rice/scratch-toggle.sh

# change focus (vim-style: h/j/k/l = left/down/up/right)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
# $mod+l locks the screen (focus right is still on $mod+Right)
bindsym $mod+l exec --no-startup-id loginctl lock-session

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window (vim-style: h/j/k/l = left/down/up/right)
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in horizontal orientation
bindsym $mod+b split h

# split in vertical orientation
bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (toggle split only)
# Tabbed/stacked layouts are disabled on purpose: no keybind can enter them,
# and new workspaces always start in split layout.
workspace_layout default
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent

# Workspace names
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Pin workspace 2 to the right (portrait) monitor by default
workspace $ws2 output HDMI-1

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# reload the configuration file
bindsym $mod+Shift+c reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart
# exit i3 (logs you out of your X session)
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# resize window (you can also use the mouse for that)
mode "resize" {
        # vim-style, same keys as focus/move: h/l = narrower/wider,
        # k/j = shorter/taller
        bindsym h resize shrink width 10 px or 10 ppt
        bindsym j resize grow height 10 px or 10 ppt
        bindsym k resize shrink height 10 px or 10 ppt
        bindsym l resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or $mod+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# Client colors — swappable via ~/.config/rice/toggle-theme.sh
include ~/.config/i3/theme.conf

# Built-in i3bar is disabled — polybar (launched above) replaces it.

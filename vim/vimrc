function! s:DrawDashboard() abort
  silent %delete _
  syntax clear

  let l:ms = float2nr(reltimefloat(reltime(g:rice_start)) * 1000)
  let l:foot = "\uf0e7" . ' ready in ' . l:ms . 'ms   ' . "\uf073" . ' ' . strftime('%A %d %B')
  let l:Center = {s -> repeat(' ', max([0, (winwidth(0) - strdisplaywidth(s)) / 2])) . s}

  let l:lines = map(copy(s:logo), 'l:Center(v:val)')
  let l:lines += ['', '', l:Center("\U000f0219" . '  ' . fnamemodify(getcwd(), ':~')), '', l:Center(l:foot)]

  let l:top = max([0, (winheight(0) - len(l:lines)) / 2])
  call setline(1, repeat([''], l:top) + l:lines)

  for l:i in range(len(s:logo))
    execute 'syntax match RiceDash' . (l:i + 1) . ' /\%' . (l:top + l:i + 1) . 'l\S.*/'
  endfor
  execute 'syntax match RiceDashText /\%' . (l:top + len(s:logo) + 3) . 'l\S.*/'
  execute 'syntax match RiceDashDim /\%' . (l:top + len(l:lines)) . 'l\S.*/'
  setlocal nomodified
  call cursor(1, 1)
  call winrestview({'topline': 1})
endfunction

" Typing anything turns the start screen back into a plain empty buffer.
function! s:LeaveDashboard() abort
  autocmd! RiceDashboardBuf * <buffer>
  silent %delete _
  syntax clear
  setlocal buftype= bufhidden= buflisted swapfile filetype=
  setlocal number relativenumber cursorline list signcolumn=yes scrolloff=6
endfunction

function! s:Dashboard() abort
  if argc() || line2byte('$') != -1 || get(g:, 'rice_stdin', 0)
    return
  endif
  enew
  setlocal buftype=nofile bufhidden=wipe nobuflisted noswapfile nonumber norelativenumber
  setlocal nocursorline nolist signcolumn=no colorcolumn= foldcolumn=0 nofoldenable scrolloff=0
  setlocal filetype=ricedash
  call s:DrawDashboard()
  augroup RiceDashboardBuf
    autocmd! * <buffer>
    autocmd InsertEnter <buffer> call s:LeaveDashboard()
    autocmd VimResized <buffer> call s:DrawDashboard()
  augroup END
endfunction

augroup RiceDashboard
  autocmd!
  autocmd StdinReadPre * let g:rice_stdin = 1
  autocmd VimEnter * nested call s:Dashboard()
augroup END

" Cursorline only in the focused window

  \ '████╗  ██║██║   ██║██║████╗ ████║',
  \ '██╔██╗ ██║██║   ██║██║██╔████╔██║',
  \ '██║╚██╗██║╚██╗ ██╔╝██║██║╚██╔╝██║',
  \ '██║ ╚████║ ╚████╔╝ ██║██║ ╚═╝ ██║',
  \ '╚═╝  ╚═══╝  ╚═══╝  ╚═╝╚═╝     ╚═╝',
  \ ] : [
  \ '██╗   ██╗██╗███╗   ███╗',
  \ '██║   ██║██║████╗ ████║',
  \ '██║   ██║██║██╔████╔██║',
  \ '╚██╗ ██╔╝██║██║╚██╔╝██║',

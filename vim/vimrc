" Shared by vim and nvim (nvim/init.vim sources this, then loads the
" nvim-only look from nvim/lua/rice.lua). No plugin manager: the
" statusline, buffer tabline and start screen below are all built in, and
" purely cosmetic — no extra keybindings.
let g:rice_start = reltime()

set nocompatible
syntax on
filetype plugin indent on

set termguicolors

" ── Rice palettes ────────────────────────────────────────────────────────
" Extra highlight groups (statusline pills, buffer tabs, dashboard
" gradient, floats) layered on top of whichever colors/*.vim is active,
" re-applied on every :colorscheme so theme switches carry them along.
let s:palettes = {
  \ 'bw': {
  \   'bg': '#000000', 'panel': '#141414', 'panel2': '#262626',
  \   'fg': '#E4E4E4', 'dim': '#7A7A7A', 'accent': '#FFFFFF', 'accent_fg': '#000000',
  \   'n': '#FFFFFF', 'i': '#BDBDBD', 'v': '#9A9A9A', 'r': '#FFFFFF', 'c': '#D6D6D6', 't': '#BDBDBD',
  \   'grad': ['#FFFFFF', '#E3E3E3', '#C7C7C7', '#ABABAB', '#8F8F8F', '#737373'],
  \   'error': '#FFFFFF', 'warn': '#BDBDBD', 'info': '#8A8A8A', 'hint': '#8A8A8A', 'mod': '#FFFFFF'},
  \ 'invert': {
  \   'bg': '#FFFFFF', 'panel': '#ECECEC', 'panel2': '#D6D6D6',
  \   'fg': '#1B1B1B', 'dim': '#757575', 'accent': '#1B1B1B', 'accent_fg': '#FFFFFF',
  \   'n': '#1B1B1B', 'i': '#3E3E3E', 'v': '#5E5E5E', 'r': '#1B1B1B', 'c': '#2E2E2E', 't': '#3E3E3E',
  \   'grad': ['#1B1B1B', '#2F2F2F', '#444444', '#585858', '#6D6D6D', '#828282'],
  \   'error': '#1B1B1B', 'warn': '#3E3E3E', 'info': '#5E5E5E', 'hint': '#757575', 'mod': '#1B1B1B'},
  \ 'catppuccin': {
  \   'bg': '#1E1E2E', 'panel': '#181825', 'panel2': '#313244',
  \   'fg': '#CDD6F4', 'dim': '#7F849C', 'accent': '#CBA6F7', 'accent_fg': '#11111B',
  \   'n': '#CBA6F7', 'i': '#A6E3A1', 'v': '#FAB387', 'r': '#F38BA8', 'c': '#F9E2AF', 't': '#94E2D5',
  \   'grad': ['#CBA6F7', '#F5C2E7', '#F38BA8', '#FAB387', '#F9E2AF', '#A6E3A1'],
  \   'error': '#F38BA8', 'warn': '#F9E2AF', 'info': '#89B4FA', 'hint': '#94E2D5', 'mod': '#FAB387'},
  \ }

function! s:Hi(group, fg, bg, attr) abort
  execute printf('hi %s guifg=%s guibg=%s gui=%s cterm=%s', a:group,
    \ empty(a:fg) ? 'NONE' : a:fg, empty(a:bg) ? 'NONE' : a:bg,
    \ empty(a:attr) ? 'NONE' : a:attr, empty(a:attr) ? 'NONE' : a:attr)
endfunction

function! s:RiceHighlights() abort
  let p = get(s:palettes, get(g:, 'colors_name', 'bw'), s:palettes.bw)
  let g:rice_palette = p

  " statusline: mode pills (body + rounded caps) on a panel strip
  for m in ['n', 'i', 'v', 'r', 'c', 't']
    call s:Hi('RiceMode' . m, p.accent_fg, p[m], 'bold')
    call s:Hi('RiceModeCap' . m, p[m], p.panel, '')
  endfor
  call s:Hi('StatusLine',    p.fg,    p.panel, '')
  call s:Hi('StatusLineNC',  p.dim,   p.panel, '')
  call s:Hi('RiceStl',       p.fg,    p.panel, '')
  call s:Hi('RiceStlDim',    p.dim,   p.panel, '')
  call s:Hi('RiceStlAccent', p.accent, p.panel, 'bold')
  call s:Hi('RiceStlMod',    p.mod,   p.panel, 'bold')
  call s:Hi('RiceStlErr',    p.error, p.panel, 'bold')
  call s:Hi('RiceStlWarn',   p.warn,  p.panel, 'bold')

  " buffer tabline
  call s:Hi('TabLineFill',    '',          p.bg,     '')
  call s:Hi('RiceTab',        p.dim,       p.panel,  '')
  call s:Hi('RiceTabCap',     p.panel,     p.bg,     '')
  call s:Hi('RiceTabSel',     p.accent_fg, p.accent, 'bold')
  call s:Hi('RiceTabSelCap',  p.accent,    p.bg,     '')
  call s:Hi('RiceTabMod',     p.mod,       p.panel,  'bold')

  " start screen: logo gradient, then text / dim
  for i in range(len(p.grad))
    call s:Hi('RiceDash' . (i + 1), p.grad[i], '', 'bold')
  endfor
  call s:Hi('RiceDashText', p.fg,     '', '')
  call s:Hi('RiceDashDim',  p.dim,    '', 'italic')

  " the rest of the UI
  call s:Hi('CursorLineNr', p.accent, '', 'bold')
  call s:Hi('WinSeparator', p.panel2, '', '')
  call s:Hi('VertSplit',    p.panel2, '', '')
  call s:Hi('NormalFloat',  p.fg,     p.bg, '')
  call s:Hi('FloatBorder',  p.accent, p.bg, '')
  call s:Hi('FloatTitle',   p.accent_fg, p.accent, 'bold')
  call s:Hi('RiceYank',     p.accent_fg, p.accent, '')
  call s:Hi('Folded',       p.dim,    p.panel, 'italic')
  call s:Hi('DiagnosticError', p.error, '', '')
  call s:Hi('DiagnosticWarn',  p.warn,  '', '')
  call s:Hi('DiagnosticInfo',  p.info,  '', '')
  call s:Hi('DiagnosticHint',  p.hint,  '', '')

  " nvim's built-in tree-sitter groups carry their own (default theme)
  " colors after :hi clear — point them back at this theme's groups
  if has('nvim')
    hi! link @variable Identifier
    hi! link @variable.member Identifier
    hi! link @property Identifier
  endif
endfunction

augroup RiceHighlights
  autocmd!
  autocmd ColorScheme * call s:RiceHighlights()
augroup END

" Follow the rice's active theme (bw / invert / catppuccin).
" Re-checks the theme file on focus and on idle (piggybacking on
" 'updatetime') so toggling with $mod+Shift+t syncs vim automatically,
" without reloading the colorscheme when nothing changed. :RiceTheme
" forces a re-check on demand.
let s:rice_last_theme = ''
function! s:RiceColorscheme(...)
  let l:theme_file = expand('~/.config/rice/theme')
  let l:theme = 'bw'
  if filereadable(l:theme_file)
    let l:theme = trim(join(readfile(l:theme_file)))
  endif
  if index(['invert', 'catppuccin'], l:theme) < 0
    let l:theme = 'bw'
  endif
  if l:theme !=# s:rice_last_theme || a:0 > 0
    execute 'colorscheme ' . l:theme
    let s:rice_last_theme = l:theme
  endif
endfunction
command! RiceTheme call s:RiceColorscheme(1)
call s:RiceColorscheme(1)
augroup RiceTheme
  autocmd!
  autocmd FocusGained,CursorHold,CursorHoldI * call s:RiceColorscheme()
augroup END

" ── Options ──────────────────────────────────────────────────────────────

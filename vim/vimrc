set splitbelow

" Closed folds show their first line plus how many lines are hidden
function! RiceFoldText() abort
  let l:line = substitute(getline(v:foldstart), '\t', repeat(' ', &tabstop), 'g')
  return l:line . '  ' . "\uf141" . ' ' . (v:foldend - v:foldstart + 1) . ' lines '
endfunction
set foldtext=RiceFoldText()


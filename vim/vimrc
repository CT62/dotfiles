" ── Statusline ───────────────────────────────────────────────────────────
"  ( NORMAL )  main   app.py ●                 E1 W2  python  12:4  ▅ 63%
let s:modes = {
  \ 'n': ['NORMAL', 'n'], 'no': ['PENDING', 'n'], 'i': ['INSERT', 'i'],
  \ 'v': ['VISUAL', 'v'], 'V': ['V-LINE', 'v'], "\<C-v>": ['V-BLOCK', 'v'],
  \ 's': ['SELECT', 'v'], 'S': ['S-LINE', 'v'], "\<C-s>": ['S-BLOCK', 'v'],
  \ 'R': ['REPLACE', 'r'], 'c': ['COMMAND', 'c'], 't': ['TERMINAL', 't'],
  \ '!': ['SHELL', 'c'], 'r': ['PROMPT', 'c'],
  \ }
let s:L = ""
let s:R = ""

function! s:Pill(group, text) abort
  return '%#RiceModeCap' . a:group . '#' . s:L . '%#RiceMode' . a:group . '#' . a:text
    \ . '%#RiceModeCap' . a:group . '#' . s:R
endfunction

" git branch, cached per buffer (refreshed on enter / write / focus)
function! s:UpdateBranch() abort
  let b:rice_branch = ''
  if !empty(&buftype) || empty(expand('%')) || !executable('git') | return | endif
  let l:out = systemlist('git -C ' . shellescape(expand('%:p:h')) . ' branch --show-current 2>/dev/null')
  if v:shell_error == 0 && !empty(l:out)
    let b:rice_branch = l:out[0]
  endif
endfunction
augroup RiceBranch
  autocmd!
  autocmd BufEnter,BufWritePost,FocusGained * call s:UpdateBranch()
augroup END

function! RiceStatusline() abort
  if get(g:, 'statusline_winid', win_getid()) != win_getid()
    return '%#StatusLineNC#   %f %m%=%l:%c   '
  endif
  let [l:name, l:grp] = get(s:modes, mode(1), get(s:modes, mode(), ['NORMAL', 'n']))
  let l:s = ' ' . s:Pill(l:grp, ' ' . l:name . ' ')
  if &filetype ==# 'ricedash'
    return l:s . '  %#RiceStlDim#' . "\uf015" . ' dashboard%='
  endif

  let l:branch = get(b:, 'rice_branch', '')
  if !empty(l:branch)
    let l:s .= '  %#RiceStlAccent#' . "" . ' ' . l:branch
  endif
  let l:fname = empty(expand('%')) ? '[No Name]' : expand('%:~:.')
  let l:s .= '  %#RiceStl#' . RiceIcon(&filetype) . ' %<' . substitute(l:fname, '%', '%%', 'g')
  if &modified | let l:s .= ' %#RiceStlMod#' . "●" | endif
  if &readonly || !&modifiable | let l:s .= ' %#RiceStlDim#' . "" | endif

  let l:s .= ' %='
  if has('nvim')
    let l:e = luaeval('#vim.diagnostic.get(0, {severity = vim.diagnostic.severity.ERROR})')
    let l:w = luaeval('#vim.diagnostic.get(0, {severity = vim.diagnostic.severity.WARN})')
    if l:e | let l:s .= '%#RiceStlErr#' . "" . ' ' . l:e . '  ' | endif
    if l:w | let l:s .= '%#RiceStlWarn#' . "" . ' ' . l:w . '  ' | endif
  endif
  if !empty(&filetype) | let l:s .= '%#RiceStlDim#' . &filetype . '  ' | endif
  let l:s .= '%#RiceStl#' . "" . ' %l:%c  '

  " position as a little fill gauge + percent
  let l:bars = ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█']
  let l:pct = line('$') <= 1 ? 100 : (line('.') - 1) * 100 / (line('$') - 1)
  let l:s .= s:Pill(l:grp, ' ' . l:bars[min([7, l:pct * 8 / 100])] . ' ' . l:pct . '%% ') . ' '
  return l:s
endfunction
set statusline=%!RiceStatusline()

" ── Buffer tabline ───────────────────────────────────────────────────────
" Open buffers as rounded tabs (current one filled), project dir on the
" right. Shown once there's more than one buffer.

function! RiceTabline() abort
  let l:s = ' '
  for l:b in getbufinfo({'buflisted': 1})
    let l:name = empty(l:b.name) ? '[No Name]' : fnamemodify(l:b.name, ':t')
    let l:label = ' ' . RiceIcon(getbufvar(l:b.bufnr, '&filetype')) . ' ' . l:name
    let l:sel = l:b.bufnr == bufnr('%')
    let [l:cap, l:body] = l:sel ? ['RiceTabSelCap', 'RiceTabSel'] : ['RiceTabCap', 'RiceTab']
    let l:s .= '%#' . l:cap . '#' . s:L . '%#' . l:body . '#' . l:label
    if l:b.changed
      let l:s .= l:sel ? ' ' . "●" : ' %#RiceTabMod#' . "●"
    endif
    let l:s .= ' %#' . l:cap . '#' . s:R . ' '
  endfor
  let l:s .= '%#TabLineFill#%=' . s:Pill('n', ' ' . "" . ' ' . fnamemodify(getcwd(), ':t') . ' ') . ' '
  return l:s
endfunction
set tabline=%!RiceTabline()

function! s:UpdateTablineVisibility() abort
  let &showtabline = len(getbufinfo({'buflisted': 1})) > 1 ? 2 : 0
endfunction
augroup RiceTabline
  autocmd!
  autocmd VimEnter,BufAdd,BufDelete,BufEnter * call timer_start(0, {-> s:UpdateTablineVisibility()})
augroup END


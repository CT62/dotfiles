set relativenumber
set cursorline
set signcolumn=yes
set scrolloff=6
set laststatus=2
set noshowmode
set shortmess+=I
set list
" cosmetic: nicer glyphs for tabs / trailing space / wrapped lines / folds,
" no ~ past the end of the buffer, thin split lines
let &listchars = "tab:\u2192 ,trail:\u00b7,nbsp:\u2423,extends:\u203a,precedes:\u2039"
let &fillchars = "eob: ,vert:\u2502,fold: ,foldopen:\uf107,foldclose:\uf105,foldsep: "
let &showbreak = "\u21aa "
set linebreak breakindent
set pumheight=12

set tabstop=4
set shiftwidth=4
set expandtab
set smartindent

set ignorecase
set smartcase
set incsearch
set hlsearch

set mouse=a
set clipboard=unnamedplus
set updatetime=300
set hidden
